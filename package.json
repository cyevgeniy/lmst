{
  "name": "lmst",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "size-limit": [
    {
      "limit": "10 kB",
      "path": "dist/assets/*.js"
    }
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-env.js && tsc && vite build && cp _redirects dist/_redirects",
    "preview": "vite preview",
    "test": "vitest run",
    "size": "npm run build && size-limit"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*.{js,ts}": "prettier --write"
  },
  "devDependencies": {
    "@size-limit/file": "^14.3.0",
    "@types/jsdom": "^30.0.0",
    "browserslist": "^4.29.5",
    "dotenv": "^18.0.10",
    "jsdom": "^31.0.0",
    "lightningcss": "^1.33.0",
    "nano-staged": "^1.0.2",
    "prettier": "^3.10.1",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true
  }
}
